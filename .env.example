# Sign in to https://steamcommunity.com/dev/apikey to request your key.
STEAM_API_KEY=PUT_YOUR_STEAM_API_KEY_HERE

# PostgreSQL local configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=steam_recommender
DB_USER=postgres
DB_PASSWORD=PUT_YOUR_POSTGRES_PASSWORD_HERE

# Keep small while testing. Increase gradually after it works.
MAX_DETAIL_REQUESTS=50
REQUEST_DELAY_SECONDS=1.5
